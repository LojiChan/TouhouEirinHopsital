# ============================================================
# 永远亭医疗模拟器 — 全局配置
# Touhou Eirin Hospital Simulator
# 兼容 TEHrunner.py v0.2.0
# ============================================================

[GAME]
title = 永远亭医疗模拟器
title_en = Touhou Eirin Hospital Simulator
version = 0.2.0
lang = zh-CN
ui_lang = zh-CN
author = Loji_
save_format = tehp

# ============================================================
# LLM 配置（TEHrunner.py 唯一强制读取段）
# ============================================================

[LLM]
provider = ollama
model = qwen2.5:7b
base_url = http://localhost:11434
temperature = 0.7
max_tokens = 2048
timeout = 300
stream = false

# ============================================================
# 资源池
# ============================================================

[POOL]
case_pool = CasePool.tehp
sentence_pool = sentences.tehp
medicine_dir = MedicineGroups
action_dir = ActionsGroups
machine_dir = MachineGroups
prompt_dir = Prompts
save_dir = Saves

# ============================================================
# 参数设置
# ============================================================

[PARAMETERS]
# 幻想活性
fantasy_activity = 普通
fantasy_options = ……现实|极低|低|普通|高|极高|完全的……梦境|随机

# 突发状况
sudden_event = 普通
sudden_options = 无|极低|低|普通|高|极高|……无时无刻|随机

# 病症罕见度
disease_rarity = 普通
rarity_options = ……首例|极少见|少见|普通|多见|季节性流行|流行|……大流行|随机

# 配合度
compliance = 普通
compliance_options = 极低|低|普通|高|极高|随机

# 病程进度速度
disease_speed = 普通
speed_options = 极慢|慢|普通|快|极快|随机

# ============================================================
# 评分
# ============================================================

[SCORING]
enable = on
total = 100
weight_diagnosis = 0.30
weight_medication = 0.25
weight_action = 0.25
weight_communication = 0.20

# ============================================================
# 界面
# ============================================================

[UI]
theme = default
show_vitals = on
show_sentence = on
sentence_interval = 10
show_version = on
show_author = on
page_size = 15

# ============================================================
# 页脚
# ============================================================

[FOOTER]
author = Loji_
format = v{version} Loji_

# ============================================================
# 世界观
# ============================================================

[WORLD]
location = 永远亭
doctor = 八意永琳
assistants = 铃仙|因幡帝
princess = 蓬莱山辉夜
crossover = 博丽灵梦|红魔馆|白玉楼|守矢神社|地灵殿|命莲寺|月都

# ============================================================
# 规则
# ============================================================

[RULES]
max_turn = 3
turn_per_day = 3
win_condition = 三回合内稳定病情
lose_condition = 三回合内未稳定病情
critical_condition = 转重症

# ============================================================
# 难度解锁
# ============================================================

[UNLOCK]
easy = 默认解锁
normal = 默认解锁
hard = 默认解锁
lunatic = 默认解锁
extra = 打通 hard 或 lunatic 后解锁

# ============================================================
# 安慰剂机制
# ============================================================

[PLACEBO]
enable = on
formula = 基础效果 × 配合度系数 × (1 + 幻想活性系数)

[PLACEBO_COMPLIANCE]
极低 = 0.0
低 = 0.1
普通 = 0.25
高 = 0.5
极高 = 0.75

[PLACEBO_FANTASY]
……现实 = 0.0
极低 = 0.05
低 = 0.1
普通 = 0.2
高 = 0.35
极高 = 0.5
完全的……梦境 = 0.7

# ============================================================
# 妖力机制
# ============================================================

[YOUKAI]
enable = on
low = 0.0~0.3
medium = 0.3~0.6
high = 0.6~0.9
extreme = 0.9~1.0

# ============================================================
# 突发事件
# ============================================================

[EVENT]
enable = on
trigger_chance = 0.3
severity_normal = 60
severity_hard = 30
severity_lunatic = 10

# ============================================================
# 远程求助
# ============================================================

[REMOTE]
enable = on
contact = 博丽灵梦|八云紫|蓬莱山辉夜|铃仙|因幡帝|雾雨魔理沙|十六夜咲夜|魂魄妖梦|东风谷早苗|芙兰朵露|西行寺幽幽子|蕾米莉亚

# ============================================================
# 音频
# ============================================================

[AUDIO]
enable = on
master_volume = 0.7
music_volume = 0.5
sfx_volume = 0.7
heartbeat_volume = 0.3
music_fade_ms = 1000
sfx_dir = Sounds
music_dir = Music

# ============================================================
# 音轨
# ============================================================

[AUDIO_CHANNELS]
music = 0
heartbeat = 1
bp_machine = 2
typewriter = 3
urgent = 4

# ============================================================
# 调试
# ============================================================

[DEBUG]
enable = false
show_prompt = false
show_raw_llm = false
skip_llm = false
god_mode = false